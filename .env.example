APP_NAME="AutoDealer ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://platform.com
APP_TIMEZONE=Asia/Karachi

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autodealer_erp
DB_USERNAME=autodealer
DB_PASSWORD=

# Cache & Session
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_DOMAIN=.platform.com
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@autodealer.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 File Storage
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=autodealer-production
AWS_URL=

# Tenancy
CENTRAL_DOMAINS=platform.com

# WhatsApp (Meta Cloud API)
WHATSAPP_API_VERSION=v19.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_VERIFY_TOKEN=

# For local development only - use public disk instead of s3
# FILESYSTEM_DISK=public
