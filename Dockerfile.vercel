FROM dunglas/frankenphp:php8.3-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libicu-dev \
    libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        bcmath \
        exif \
        pcntl \
        intl \
        gd \
        zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

COPY . .

# Aiven MySQL requires TLS. The CA certificate is bundled into the image.
ENV MYSQL_ATTR_SSL_CA=/app/ca.pem

# Prepare Laravel writable/cache directories before Artisan package discovery.
RUN mkdir -p storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && rm -f bootstrap/cache/packages.php bootstrap/cache/services.php \
    && chmod -R 775 storage bootstrap/cache \
    && php artisan package:discover --ansi

ENV SERVER_NAME=:80

EXPOSE 80

# Vercel can start multiple container instances at the same time. MySQL's
# advisory lock serializes migrations/seeders so two instances cannot create
# the same table concurrently. The lock connection stays alive for the whole
# migration + seeding process and is released automatically on exit.
CMD ["sh", "-c", "php -r '$host=getenv(\"DB_HOST\"); $port=getenv(\"DB_PORT\") ?: \"3306\"; $db=getenv(\"DB_DATABASE\"); $user=getenv(\"DB_USERNAME\"); $pass=getenv(\"DB_PASSWORD\"); $ca=getenv(\"MYSQL_ATTR_SSL_CA\"); $pdo=new PDO(\"mysql:host=$host;port=$port;dbname=$db;charset=utf8mb4\", $user, $pass, [PDO::MYSQL_ATTR_SSL_CA=>$ca, PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]); $lock=\"automotive_erp_migrations\"; $stmt=$pdo->query(\"SELECT GET_LOCK(\" . $pdo->quote($lock) . \", 300)\"); if ((int)$stmt->fetchColumn() !== 1) { fwrite(STDERR, \"Could not acquire database migration lock.\\n\"); exit(1); } try { passthru(\"php artisan migrate --force && php artisan db:seed --force\", $exitCode); exit($exitCode); } finally { $pdo->query(\"SELECT RELEASE_LOCK(\" . $pdo->quote($lock) . \")\"); }' && exec frankenphp php-server --root public"]
