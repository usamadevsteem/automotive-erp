FROM dunglas/frankenphp:php8.3-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libicu-dev \
    libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo_mysql \
        mbstring \
        bcmath \
        exif \
        pcntl \
        intl \
        gd \
        zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

COPY . .

# Aiven MySQL requires TLS. The CA certificate is bundled into the image.
ENV MYSQL_ATTR_SSL_CA=/app/ca.pem

# Prepare Laravel writable/cache directories before Artisan package discovery.
RUN mkdir -p storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && rm -f bootstrap/cache/packages.php bootstrap/cache/services.php \
    && chmod -R 775 storage bootstrap/cache \
    && php artisan package:discover --ansi

ENV SERVER_NAME=:80

EXPOSE 80

# Initialize the external Aiven database before serving requests.
# Migrations and the default seeders are idempotent; the demo tenant seeder
# only creates the demo tenant when it does not already exist.
CMD ["sh", "-c", "php artisan migrate --force && php artisan db:seed --force && exec frankenphp php-server --root public"]
